# VíaClara — copiar a .env.local. NUNCA commitear valores reales.
# La app móvil (mobile/) usa su propio mobile/.env con EXPO_PUBLIC_API_BASE_URL.
# Supabase: DATABASE_URL = pooler en modo transacción (puerto 6543, ?pgbouncer=true); DIRECT_URL = conexión directa (5432).
DATABASE_URL=
DIRECT_URL=
APP_BASE_URL=http://localhost:3000
# Login de admin/operador (/admin y /camaras): cuenta en la tabla AdminUser.
# SESSION_SECRET firma las cookies de sesión (≥ 32 caracteres, p. ej. `openssl rand -base64 48`). Obligatoria en Vercel.
SESSION_SECRET=
# Solo para sembrar la cuenta inicial con `pnpm db:seed` (se guarda el hash, nunca la contraseña). Mín. 10 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
OFFICER_PASSCODE=
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=
CAMERA_API_KEY=
VISION_CONFIDENCE_THRESHOLD=0.8
DEMO_VISION_CACHE=false
BLOB_READ_WRITE_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Cédula real de quien presenta (p. ej. V12345678): `pnpm db:seed` le crea un titular con multas FALSAS para probar el portal.
DEMO_CEDULA=
DEMO_PHONE_DRIVER=
DEMO_PHONE_OFFICER=
ALERT_RADIUS_METERS=1500
NOTIFY_DRY_RUN=true
USE_MOCKS=false
