{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/payments/c2p",
      "destination": "/api/p3?route=payments-c2p"
    },
    {
      "source": "/api/officers/session",
      "destination": "/api/p3?route=officer-session"
    },
    {
      "source": "/api/officers/location",
      "destination": "/api/p3?route=officer-location"
    },
    {
      "source": "/api/officers/:id/alerts",
      "destination": "/api/p3?route=officer-alerts&id=:id"
    },
    {
      "source": "/api/alerts/:id/ack",
      "destination": "/api/p3?route=alert-ack&id=:id"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/p1?route=auth-login"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/p1?route=auth-logout"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/p1?route=auth-me"
    },
    {
      "source": "/api/violations",
      "destination": "/api/p1?route=violations-list"
    },
    {
      "source": "/api/violations/:id/review",
      "destination": "/api/p1?route=violation-review&id=:id"
    },
    {
      "source": "/api/violations/:id",
      "destination": "/api/p1?route=violation-detail&id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
